{
  "manifest_version": 3,
  "name": "ADHuman Visual — Perfis com Ollama",
  "version": "3.3.0",
  "description": "Extensão ADHuman para experimento preliminar perfil × site, com Classifier selecionando L0-L3 e Ollama simulando a participação humana.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Abrir ADHuman",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8000"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
